generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  branch    String   @default("")
  porishod  String   @default("")
  subUnit   String   @default("")
  role      String   @default("member")
  branchRole String  @default("")
  joinStatus String  @default("new")
  image     String?  // Telegram file_id
  createdAt DateTime @default(now())
}

model Committee {
  id          Int    @id @default(autoincrement())
  parent      String
  branchName  String
  leafName    String
  workerCount Int    @default(0)
}

model Event {
  id     Int    @id @default(autoincrement())
  name   String
  date   String
  duties String?
}

model User {
  id           Int      @id @default(autoincrement())
  branch       String   @unique  // e.g. "05NO"
  passwordHash String
  role         String   @default("member")  // "admin" | "member"
  createdAt    DateTime @default(now())
}

model SpecialDuty {
  id             Int      @id @default(autoincrement())
  branch         String
  day            String   // e.g. "বুধবার"
  startTime      String   // e.g. "রাত ৮:০০"
  endTime        String   // e.g. "সকাল ৮:০০"
  startDate      String?  // e.g. "2025-07-23"
  description    String?
  presentWorkers Json     @default("[]")  // number[]
  groups         Json     @default("[]")  // DutyGroup[]
  createdAt      DateTime @default(now())
}
